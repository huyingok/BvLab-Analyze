                   <item>
                    <widget class="QGroupBox" name="making_info_groupBox">
                     <property name="minimumSize">
                      <size>
                       <width>0</width>
                       <height>0</height>
                      </size>
                     </property>
                     <property name="styleSheet">
                      <string notr="true">QGroupBox#making_info_groupBox
{
	border: 1px solid rgb(70,80,100);
	margin-top: 3.0ex;
}
QGroupBox#making_info_groupBox::title
{
	subcontrol-origin:margin;
	left: 10px;
}</string>
                     </property>
                     <property name="title">
                      <string>Hint Text </string>
                     </property>
                     <layout class="QVBoxLayout" name="verticalLayout_14">
                      <property name="leftMargin">
                       <number>3</number>
                      </property>
                      <property name="topMargin">
                       <number>9</number>
